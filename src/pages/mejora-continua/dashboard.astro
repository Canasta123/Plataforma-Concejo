---
import MesaAyudaLayout from '../../layouts/MesaAyudaLayout.astro';
import { getSession } from '../../lib/auth';
import { esGestorMejora } from '../../lib/mejora-auth';
import { supabase } from '../../lib/supabase';
import MejoraCharts from '../../components/mejora-continua/MejoraCharts.svelte';

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/mesa-ayuda/login');

const isGestor = await esGestorMejora(session);
if (!isGestor) return Astro.redirect('/mejora-continua/mis-hallazgos');

// Fetch aggregated metrics server-side
const [{ data: hallazgos }, { data: procesos }] = await Promise.all([
  supabase.from('hallazgos').select('id, tipo, estado, proceso_id, fecha_limite, intentos_reformulacion, created_at'),
  supabase.from('procesos_sgc').select('id, nombre')
]);

const list = hallazgos || [];
const total = list.length;

// Counts by status
const porEstado = {
  abierto: list.filter(h => h.estado === 'abierto').length,
  en_tratamiento: list.filter(h => h.estado === 'en_tratamiento').length,
  en_analisis: list.filter(h => h.estado === 'en_analisis').length,
  en_plan_accion: list.filter(h => h.estado === 'en_plan_accion').length,
  en_evaluacion: list.filter(h => h.estado === 'en_evaluacion').length,
  cerrado_eficaz: list.filter(h => h.estado === 'cerrado_eficaz').length,
  cerrado_no_eficaz: list.filter(h => h.estado === 'cerrado_no_eficaz').length,
  reformulado: list.filter(h => h.estado === 'reformulado').length,
};

// Counts by type
const porTipo = {
  no_conformidad_mayor: list.filter(h => h.tipo === 'no_conformidad_mayor' || h.tipo === 'correctiva').length,
  no_conformidad_menor: list.filter(h => h.tipo === 'no_conformidad_menor').length,
  oportunidad_mejora: list.filter(h => h.tipo === 'oportunidad_mejora' || h.tipo === 'mejora').length,
  producto_no_conforme: list.filter(h => h.tipo === 'producto_no_conforme').length,
  correctiva: list.filter(h => h.tipo === 'correctiva').length,
  mejora: list.filter(h => h.tipo === 'mejora').length,
  riesgo: list.filter(h => h.tipo === 'riesgo').length,
};

// Efficacy rate
const totalCerrados = porEstado.cerrado_eficaz + porEstado.cerrado_no_eficaz;
const eficaciaPct = totalCerrados > 0 ? Math.round((porEstado.cerrado_eficaz / totalCerrados) * 100) : 100;

// Overdue
const nowIso = new Date().toISOString();
const vencidos = list.filter(h => h.fecha_limite && h.fecha_limite < nowIso && !['cerrado_eficaz', 'cerrado_no_eficaz'].includes(h.estado)).length;

// Reformulated total
const reformulados = list.filter(h => (h.intentos_reformulacion || 0) > 0).length;

// By process
const procesoMap: Record<string, number> = {};
list.forEach(h => {
  if (h.proceso_id) {
    procesoMap[h.proceso_id] = (procesoMap[h.proceso_id] || 0) + 1;
  }
});

const porProceso = (procesos || [])
  .map(p => ({ id: p.id, nombre: p.nombre, count: procesoMap[p.id] || 0 }))
  .filter(p => p.count > 0);

const chartData = {
  total,
  eficaciaPct,
  vencidos,
  reformulados,
  porTipo,
  porEstado,
  porProceso
};
---

<MesaAyudaLayout title="Dashboard — Mejora Continua">
  <div class="max-w-7xl mx-auto px-4 py-8 font-['Lato']">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 font-['Montserrat']">Tablero de Mejora Continua</h1>
        <p class="text-sm text-gray-500 mt-1">Indicadores, análisis de eficacia y estado global de no conformidades</p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/mejora-continua/mis-hallazgos"
          class="px-4 py-2 bg-white text-gray-700 border border-gray-200 rounded-xl text-sm font-bold hover:bg-gray-50 transition-colors"
        >
          <i class="fas fa-list mr-2 text-[#3359A4]"></i> Ver Todos los Hallazgos
        </a>
        <a
          href="/mejora-continua/nuevo"
          class="px-4 py-2 bg-[#3359A4] text-white rounded-xl text-sm font-bold hover:bg-blue-800 transition-colors shadow-sm"
        >
          <i class="fas fa-plus mr-2"></i> Nuevo Hallazgo
        </a>
      </div>
    </div>

    <MejoraCharts client:load data={chartData} />
  </div>
</MesaAyudaLayout>
