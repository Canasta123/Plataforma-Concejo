---
import MesaAyudaLayout from '../../../layouts/MesaAyudaLayout.astro';
import { getSession } from '../../../lib/auth';
import { esGestorMejora } from '../../../lib/mejora-auth';
import { supabase } from '../../../lib/supabase';

import TratamientosInmediatos from '../../../components/mejora-continua/TratamientosInmediatos.svelte';
import AnalisisCausasContainer from '../../../components/mejora-continua/AnalisisCausasContainer.svelte';
import PlanAccionTable from '../../../components/mejora-continua/PlanAccionTable.svelte';
import EvaluacionEficaciaForm from '../../../components/mejora-continua/EvaluacionEficaciaForm.svelte';
import AdjuntosHallazgo from '../../../components/mejora-continua/AdjuntosHallazgo.svelte';

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/mesa-ayuda/login');

const { id } = Astro.params;
const isGestor = await esGestorMejora(session);

// Fetch hallazgo base data
const { data: hallazgo } = await supabase
  .from('hallazgos')
  .select('*, proceso:procesos_sgc(nombre), creador:usuarios!creador_id(nombre, cargo), responsable:usuarios!responsable_id(nombre, cargo)')
  .eq('id', id)
  .single();

if (!hallazgo) {
  return Astro.redirect('/mejora-continua/mis-hallazgos');
}

// Fetch all related data in parallel
const [
  { data: tratamientos },
  { data: analisisList },
  { data: tareas },
  { data: evaluaciones },
  { data: trazabilidad },
  { data: adjuntos },
  { data: usuarios }
] = await Promise.all([
  supabase.from('tratamientos_inmediatos').select('*').eq('hallazgo_id', id).order('created_at'),
  supabase.from('analisis_causas').select('*').eq('hallazgo_id', id).order('created_at', { ascending: false }),
  supabase.from('plan_accion_tareas').select('*').eq('hallazgo_id', id).order('created_at'),
  supabase.from('evaluaciones_eficacia').select('*').eq('hallazgo_id', id).order('created_at'),
  supabase.from('hallazgo_trazabilidad').select('*, autor:usuarios!autor_id(nombre)').eq('hallazgo_id', id).order('created_at', { ascending: false }),
  supabase.from('hallazgo_adjuntos').select('*, subido_por:usuarios!subido_por(nombre)').eq('hallazgo_id', id).order('created_at'),
  supabase.from('usuarios').select('id, nombre, cargo').eq('activo', true).order('nombre')
]);

const h = hallazgo;
const latestAnalisis = analisisList && analisisList.length > 0 ? analisisList[0] : null;
const isGestorOrResponsable = isGestor || h.responsable_id === session.id || h.creador_id === session.id;

const getTipoBadge = (tipo: string) => {
  switch (tipo) {
    case 'no_conformidad_mayor':
    case 'correctiva':
      return 'bg-red-100 text-red-700 border-red-200';
    case 'no_conformidad_menor':
      return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'oportunidad_mejora':
    case 'mejora':
      return 'bg-blue-100 text-blue-700 border-blue-200';
    case 'producto_no_conforme':
      return 'bg-purple-100 text-purple-700 border-purple-200';
    case 'riesgo':
      return 'bg-amber-100 text-amber-700 border-amber-200';
    default:
      return 'bg-gray-100 text-gray-700 border-gray-200';
  }
};

const getTipoLabel = (tipo: string) => {
  switch (tipo) {
    case 'no_conformidad_mayor':
    case 'correctiva':
      return 'No conformidad Mayor';
    case 'no_conformidad_menor':
      return 'No conformidad Menor';
    case 'oportunidad_mejora':
    case 'mejora':
      return 'Oportunidad de Mejora';
    case 'producto_no_conforme':
      return 'Producto no Conforme';
    case 'riesgo':
      return 'Acción sobre Riesgo';
    default:
      return tipo || 'Desconocido';
  }
};

const getEstadoBadge = (estado: string) => {
  switch (estado) {
    case 'abierto': return 'bg-blue-100 text-blue-700 border-blue-200';
    case 'en_tratamiento': return 'bg-amber-100 text-amber-700 border-amber-200';
    case 'en_analisis': return 'bg-indigo-100 text-indigo-700 border-indigo-200';
    case 'en_plan_accion': return 'bg-cyan-100 text-cyan-700 border-cyan-200';
    case 'en_evaluacion': return 'bg-purple-100 text-purple-700 border-purple-200';
    case 'cerrado_eficaz': return 'bg-green-100 text-green-700 border-green-200';
    case 'cerrado_no_eficaz': return 'bg-red-100 text-red-700 border-red-200';
    case 'reformulado': return 'bg-orange-100 text-orange-700 border-orange-200';
    default: return 'bg-gray-100 text-gray-700 border-gray-200';
  }
};

const getEstadoLabel = (estado: string) => {
  return estado ? estado.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') : 'Sin estado';
};

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return 'N/A';
  return new Date(dateStr).toLocaleDateString('es-CO');
};

const formatDateTime = (dateStr: string | null) => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleString('es-CO', { 
    year: 'numeric', month: 'short', day: 'numeric', 
    hour: '2-digit', minute:'2-digit' 
  });
};

const stages = [
  { id: 1, label: 'Registro e Identificación' },
  { id: 2, label: 'Tratamiento Inmediato' },
  { id: 3, label: 'Análisis de Causas' },
  { id: 4, label: 'Plan de Acción' },
  { id: 5, label: 'Evaluación de Eficacia' }
];

const currentStageNumber = h.etapa_actual || 1;
---

<MesaAyudaLayout title={`Hallazgo ${h.codigo || id} — Mejora Continua`}>
  <div class="max-w-7xl mx-auto px-4 py-8 font-['Lato']">
    
    <!-- Top Navigation Breadcrumb -->
    <div class="mb-4 flex items-center justify-between">
      <a href="/mejora-continua/mis-hallazgos" class="inline-flex items-center text-xs font-bold text-[#3359A4] hover:underline gap-1">
        <i class="fas fa-arrow-left"></i> Volver a Mis Hallazgos
      </a>
      <div class="text-xs text-gray-400">
        Origen: <span class="capitalize font-semibold text-gray-600">{h.origen}</span>
      </div>
    </div>

    <!-- Header Card -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mb-6">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="text-xs font-bold bg-gray-100 text-gray-800 px-3 py-1 rounded-md border border-gray-200 tracking-wider">
              {h.codigo}
            </span>
            <span class={`px-3 py-1 rounded-md text-xs font-bold border ${getTipoBadge(h.tipo)}`}>
              {getTipoLabel(h.tipo)}
            </span>
            <span class={`px-3 py-1 rounded-md text-xs font-bold border ${getEstadoBadge(h.estado)}`}>
              {getEstadoLabel(h.estado)}
            </span>
            {h.intentos_reformulacion > 0 && (
              <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-orange-100 text-orange-800 border border-orange-200">
                <i class="fas fa-redo-alt mr-1"></i> Reformulación #{h.intentos_reformulacion}
              </span>
            )}
          </div>
          <h1 class="text-2xl font-bold text-gray-900 font-['Montserrat'] mb-2">{h.titulo}</h1>
          <p class="text-xs text-gray-500">Detectado el {formatDate(h.fecha_deteccion)} por <strong class="text-gray-700">{h.creador?.nombre || 'Usuario'}</strong></p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <a
            href={`/api/mejora-continua/hallazgos/${h.id}/pdf`}
            target="_blank"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-600 text-white rounded-xl font-bold text-sm shadow hover:bg-red-700 transition-all"
          >
            <i class="fas fa-file-pdf"></i> Exportar PDF
          </a>

          {isGestorOrResponsable && currentStageNumber === 1 && (
            <button
              type="button"
              onclick={`
                fetch('/api/mejora-continua/hallazgos/${h.id}', {
                  method: 'PATCH',
                  headers: {'Content-Type': 'application/json'},
                  body: JSON.stringify({ etapa_actual: 2 })
                }).then(() => window.location.reload())
              `}
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#3359A4] text-white rounded-xl font-bold text-sm shadow hover:bg-blue-800 transition-all"
            >
              Iniciar Tratamiento (Etapa 2) <i class="fas fa-arrow-right"></i>
            </button>
          )}
        </div>
      </div>
    </div>

    <!-- Metadata Grid Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
        <p class="text-[10px] text-gray-400 mb-1 font-bold uppercase tracking-wider">Proceso SGC</p>
        <p class="text-xs font-bold text-gray-800 truncate" title={h.proceso?.nombre || 'N/A'}>
          {h.proceso?.nombre || 'N/A'}
        </p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
        <p class="text-[10px] text-gray-400 mb-1 font-bold uppercase tracking-wider">Responsable General</p>
        <p class="text-xs font-bold text-gray-800 truncate" title={h.responsable?.nombre || 'Sin asignar'}>
          {h.responsable?.nombre || 'Sin asignar'}
        </p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
        <p class="text-[10px] text-gray-400 mb-1 font-bold uppercase tracking-wider">Creado Por</p>
        <p class="text-xs font-bold text-gray-800 truncate" title={h.creador?.nombre || 'N/A'}>
          {h.creador?.nombre || 'N/A'}
        </p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
        <p class="text-[10px] text-gray-400 mb-1 font-bold uppercase tracking-wider">Fecha Detección</p>
        <p class="text-xs font-bold text-gray-800">{formatDate(h.fecha_deteccion)}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
        <p class="text-[10px] text-gray-400 mb-1 font-bold uppercase tracking-wider">Fecha Límite</p>
        <p class="text-xs font-bold text-gray-800">{formatDate(h.fecha_limite)}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
        <p class="text-[10px] text-gray-400 mb-1 font-bold uppercase tracking-wider">Requisito</p>
        <p class="text-xs font-bold text-gray-800 truncate" title={h.requisito_incumplido || 'N/A'}>
          {h.requisito_incumplido || 'N/A'}
        </p>
      </div>
    </div>

    <!-- Stepper (5 Etapas) -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mb-8 overflow-x-auto">
      <div class="flex items-center justify-between min-w-[700px]">
        {stages.map((stage) => {
          const isCompleted = stage.id < currentStageNumber;
          const isCurrent = stage.id === currentStageNumber;

          let circleClass = '';
          let textClass = '';
          
          if (isCompleted) {
            circleClass = 'bg-green-600 text-white border-green-600 shadow-sm';
            textClass = 'text-green-700 font-bold';
          } else if (isCurrent) {
            circleClass = 'bg-[#3359A4] text-white border-[#3359A4] ring-4 ring-blue-100 shadow-md';
            textClass = 'text-[#3359A4] font-bold';
          } else {
            circleClass = 'bg-gray-100 text-gray-400 border-gray-300';
            textClass = 'text-gray-400 font-medium';
          }

          return (
            <div class="flex items-center flex-1 last:flex-none">
              <div class="flex flex-col items-center relative group">
                <div class={`w-10 h-10 rounded-full flex items-center justify-center border-2 transition-all duration-300 ${circleClass}`}>
                  {isCompleted ? (
                    <i class="fas fa-check text-sm"></i>
                  ) : (
                    <span class="text-sm font-bold">{stage.id}</span>
                  )}
                </div>
                <span class={`mt-2 whitespace-nowrap text-xs text-center transition-all duration-300 ${textClass}`}>
                  {stage.label}
                </span>
              </div>
              
              {stage.id < stages.length && (
                <div class={`flex-1 h-1 mx-3 rounded transition-all duration-300 ${isCompleted ? 'bg-green-500' : 'bg-gray-200'}`}></div>
              )}
            </div>
          );
        })}
      </div>
    </div>

    <!-- Content Area & Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Interactive Content (2 Cols) -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Hallazgo Base Description Card -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-base font-bold text-gray-900 font-['Montserrat'] mb-3 flex items-center gap-2">
            <i class="fas fa-align-left text-[#3359A4]"></i> Descripción del Hallazgo
          </h2>
          <div class="bg-gray-50 rounded-xl p-4 border border-gray-200 text-sm text-gray-800 whitespace-pre-wrap leading-relaxed">
            {h.descripcion}
          </div>
          {h.requisito_incumplido && (
            <div class="mt-4 p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-900">
              <strong>Requisito incumplido / Numeral normativo:</strong> {h.requisito_incumplido}
            </div>
          )}
        </div>

        <!-- Stage 2: Tratamientos Inmediatos -->
        {currentStageNumber >= 2 && (
          <TratamientosInmediatos
            client:load
            hallazgoId={h.id}
            tratamientos={tratamientos || []}
            isGestorOrResponsable={isGestorOrResponsable}
            currentUserId={session.id}
            usuarios={usuarios || []}
          />
        )}

        <!-- Stage 3: Análisis de Causas -->
        {currentStageNumber >= 3 && (
          <AnalisisCausasContainer
            client:load
            hallazgoId={h.id}
            analisis={latestAnalisis}
            isGestorOrResponsable={isGestorOrResponsable}
            minPorques={3}
          />
        )}

        <!-- Stage 4: Plan de Acción -->
        {currentStageNumber >= 4 && (
          <PlanAccionTable
            client:load
            hallazgoId={h.id}
            tareas={tareas || []}
            isGestorOrResponsable={isGestorOrResponsable}
            currentUserId={session.id}
            usuarios={usuarios || []}
          />
        )}

        <!-- Stage 5: Evaluación de Eficacia -->
        {currentStageNumber >= 5 && (
          <EvaluacionEficaciaForm
            client:load
            hallazgoId={h.id}
            evaluaciones={evaluaciones || []}
            isGestor={isGestor}
            intentosReformulacion={h.intentos_reformulacion || 0}
            maxReformulaciones={3}
          />
        )}

        <!-- Evidencias y Archivos Adjuntos -->
        <AdjuntosHallazgo
          client:load
          hallazgoId={h.id}
          etapa={currentStageNumber}
          adjuntos={adjuntos || []}
          isGestorOrResponsable={isGestorOrResponsable}
        />

      </div>

      <!-- Right Sidebar: Trazabilidad & Timeline -->
      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h3 class="text-base font-bold text-gray-900 font-['Montserrat'] mb-6 flex items-center gap-2">
            <i class="fas fa-history text-[#3359A4]"></i> Trazabilidad del Hallazgo
          </h3>

          {trazabilidad && trazabilidad.length > 0 ? (
            <div class="space-y-4">
              {trazabilidad.map((t) => (
                <div class="p-3 bg-gray-50 rounded-xl border border-gray-200 text-xs">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-[#3359A4] uppercase text-[10px] tracking-wider">{t.tipo}</span>
                    <span class="text-[10px] text-gray-400">{formatDateTime(t.created_at)}</span>
                  </div>
                  <p class="text-gray-800 font-medium mb-1">{t.contenido}</p>
                  <p class="text-[10px] text-gray-500">Por: <strong class="text-gray-700">{t.autor?.nombre || 'Sistema'}</strong></p>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-xs text-gray-400 text-center py-6 bg-gray-50 rounded-xl border border-dashed border-gray-200">
              No hay eventos en la trazabilidad.
            </div>
          )}
        </div>
      </div>

    </div>

  </div>
</MesaAyudaLayout>
