---
import MesaAyudaLayout from '../../layouts/MesaAyudaLayout.astro';
import { getSession } from '../../lib/auth';
import { esGestorMejora } from '../../lib/mejora-auth';
import { supabase } from '../../lib/supabase';

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect('/mesa-ayuda/login');

const isGestor = await esGestorMejora(session);

const { data: procesos } = await supabase
  .from('procesos_sgc')
  .select('id, nombre')
  .eq('activo', true)
  .order('orden', { ascending: true });

let usuarios: any[] = [];
if (isGestor) {
  const { data: usrs } = await supabase
    .from('usuarios')
    .select('id, nombre, cargo')
    .eq('activo', true)
    .order('nombre');
  if (usrs) usuarios = usrs;
}
---
<MesaAyudaLayout title="Nuevo Hallazgo - Mejora Continua">
  <div class="max-w-3xl mx-auto px-4 py-8">
    <div class="flex items-center gap-3 mb-8">
      <a href="/mejora-continua" class="text-gray-400 hover:text-gray-600 transition-colors">
        <i class="fas fa-arrow-left"></i>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-gray-900 font-['Montserrat']">Registrar Nuevo Hallazgo</h1>
        <p class="text-sm text-gray-500 mt-0.5 font-['Lato']">Inicia un proceso de mejora o corrección</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8 font-['Lato']">
      <form id="hallazgo-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="col-span-1 md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Título *</label>
            <input type="text" id="titulo" name="titulo" required
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#3359A4] focus:ring-[#3359A4] text-sm py-2 px-3 border"
              placeholder="Ej: Ausencia de firmas en actas de comité" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Hallazgo *</label>
            <select id="tipo" name="tipo" required
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#3359A4] focus:ring-[#3359A4] text-sm py-2 px-3 border">
              <option value="">Seleccione...</option>
              <option value="no_conformidad_mayor">No conformidad Mayor</option>
              <option value="no_conformidad_menor">No conformidad Menor</option>
              <option value="oportunidad_mejora">Oportunidad de Mejora</option>
              <option value="producto_no_conforme">Producto no Conforme</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Proceso Relacionado *</label>
            <select id="proceso_id" name="proceso_id" required
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#3359A4] focus:ring-[#3359A4] text-sm py-2 px-3 border">
              <option value="">Seleccione un proceso...</option>
              {procesos?.map(p => (
                <option value={p.id}>{p.nombre}</option>
              ))}
            </select>
          </div>

          <div class="col-span-1 md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Descripción del Hallazgo *</label>
            <textarea id="descripcion" name="descripcion" rows="4" required
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#3359A4] focus:ring-[#3359A4] text-sm py-2 px-3 border"
              placeholder="Describe detalladamente lo encontrado..."></textarea>
          </div>

          <div class="col-span-1 md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Requisito Incumplido (Opcional)</label>
            <textarea id="requisito_incumplido" name="requisito_incumplido" rows="2"
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#3359A4] focus:ring-[#3359A4] text-sm py-2 px-3 border"
              placeholder="Norma, numeral o política afectada..."></textarea>
          </div>

          {isGestor && (
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Asignar Responsable</label>
              <select id="responsable_id" name="responsable_id"
                class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#3359A4] focus:ring-[#3359A4] text-sm py-2 px-3 border">
                <option value="">Asignar más tarde o autocontrol...</option>
                {usuarios.map(u => (
                  <option value={u.id}>{u.nombre} - {u.cargo}</option>
                ))}
              </select>
            </div>
          )}

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Fecha Límite Sugerida (Opcional)</label>
            <input type="date" id="fecha_limite" name="fecha_limite"
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-[#3359A4] focus:ring-[#3359A4] text-sm py-2 px-3 border" />
          </div>
        </div>

        <div id="error-msg" class="hidden text-red-600 text-sm font-medium bg-red-50 p-3 rounded-lg border border-red-100"></div>

        <div class="pt-4 flex justify-end gap-3 border-t border-gray-100">
          <a href="/mejora-continua" class="px-4 py-2 text-gray-600 hover:text-gray-900 font-medium text-sm transition-colors">
            Cancelar
          </a>
          <button type="submit" id="submit-btn" class="px-5 py-2 bg-[#3359A4] hover:bg-blue-800 text-white rounded-lg font-medium text-sm shadow-sm transition-colors flex items-center">
            <span>Registrar Hallazgo</span>
            <i class="fas fa-spinner fa-spin ml-2 hidden" id="spinner"></i>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('hallazgo-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const spinner = document.getElementById('spinner') as HTMLElement;
    const errorMsg = document.getElementById('error-msg') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        submitBtn.disabled = true;
        spinner.classList.remove('hidden');
        errorMsg.classList.add('hidden');

        const response = await fetch('/api/mejora-continua/hallazgos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (!response.ok) {
          const resData = await response.json().catch(() => ({}));
          throw new Error(resData.error || 'Error al crear el hallazgo');
        }

        const resData = await response.json();
        // Redirect to detail page
        window.location.href = `/mejora-continua/hallazgo/${resData.id || resData.data?.id}`;
      } catch (err: any) {
        errorMsg.textContent = err.message;
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        spinner.classList.add('hidden');
      }
    });
  </script>
</MesaAyudaLayout>
